        "\n",
        "import copy\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# ============================================================\n",
        "# 1. Configuration\n",
        "# ============================================================\n",
        "\n",
        "SEED = 42\n",
        "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "# Reward model sizes and preference dataset sizes\n",
        "MODEL_SIZES = [8, 32, 128]\n",
        "DATA_SIZES = [500, 2000, 8000]\n",
        "\n",
        "INPUT_DIM = 6\n",
        "TRAIN_EPOCHS = 120\n",
        "OPTIMIZATION_STEPS = 300\n",
        "LEARNING_RATE = 0.025\n",
        "KL_COEFFICIENT = 0.03\n",
        "PREFERENCE_TEMPERATURE = 0.5\n",
        "\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "torch.manual_seed(SEED)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.manual_seed_all(SEED)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Ground-truth reward function\n",
        "# ============================================================\n",
        "\n",
        "def true_reward(x):\n",
        "    \"\"\"\n",
        "    x[:, 0:3] contain useful features.\n",
        "    x[:, 3:6] are nuisance features with no true reward value.\n",
        "\n",
        "    This gives us a known ground truth against which\n",
        "    reward hacking can be measured.\n",
        "    \"\"\"\n",
        "    return (\n",
        "        x[:, 0]\n",
        "        - 0.7 * x[:, 1] ** 2\n",
        "        + 0.25 * x[:, 2]\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Generate pairwise preference data\n",
        "# ============================================================\n",
        "\n",
        "def generate_preferences(n_pairs):\n",
        "    \"\"\"\n",
        "    Generate comparisons (x_a, x_b).\n",
        "\n",
        "    Preference labels are sampled from a noisy\n",
        "    Bradley-Terry model based on the true reward.\n",
        "    \"\"\"\n",
        "    x_a = np.random.normal(\n",
        "        0, 1, size=(n_pairs, INPUT_DIM)\n",
        "    ).astype(np.float32)\n",
        "\n",
        "    x_b = np.random.normal(\n",
        "        0, 1, size=(n_pairs, INPUT_DIM)\n",
        "    ).astype(np.float32)\n",
        "\n",
        "    # Keep the training distribution bounded.\n",
        "    x_a = np.clip(x_a, -3, 3)\n",
        "    x_b = np.clip(x_b, -3, 3)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        ta = true_reward(torch.tensor(x_a)).numpy()\n",
        "        tb = true_reward(torch.tensor(x_b)).numpy()\n",
        "\n",
        "    logits = (ta - tb) / PREFERENCE_TEMPERATURE\n",
        "    probabilities = 1.0 / (1.0 + np.exp(-logits))\n",
        "\n",
        "    labels = np.random.binomial(\n",
        "        1, probabilities\n",
        "    ).astype(np.float32)\n",
        "\n",
        "    return (\n",
        "        torch.tensor(x_a, device=DEVICE),\n",
        "        torch.tensor(x_b, device=DEVICE),\n",
        "        torch.tensor(labels, device=DEVICE),\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Reward model\n",
        "# ============================================================\n",
        "\n",
        "class RewardModel(nn.Module):\n",
        "    def __init__(self, hidden_size):\n",
        "        super().__init__()\n",
        "\n",
        "        self.network = nn.Sequential(\n",
        "            nn.Linear(INPUT_DIM, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, 1),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.network(x).squeeze(-1)\n",
        "\n",
        "\n",
        "def train_reward_model(hidden_size, n_pairs):\n",
        "    x_a, x_b, labels = generate_preferences(n_pairs)\n",
        "\n",
        "    model = RewardModel(hidden_size).to(DEVICE)\n",
        "    optimizer = torch.optim.Adam(\n",
        "        model.parameters(), lr=0.003, weight_decay=1e-4\n",
        "    )\n",
        "    loss_fn = nn.BCEWithLogitsLoss()\n",
        "\n",
        "    model.train()\n",
        "\n",
        "    for epoch in range(TRAIN_EPOCHS):\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        reward_a = model(x_a)\n",
        "        reward_b = model(x_b)\n",
        "\n",
        "        # Bradley-Terry preference probability:\n",
        "        # P(a preferred to b) = sigmoid(r(a) - r(b))\n",
        "        predicted_difference = reward_a - reward_b\n",
        "\n",
        "        loss = loss_fn(predicted_difference, labels)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "    return model\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Policy optimization against the learned reward\n",
        "# ============================================================\n",
        "\n",
        "def optimize_policy(model):\n",
        "    \"\"\"\n",
        "    The policy is represented by a trainable action vector.\n",
        "\n",
        "    It maximizes:\n",
        "        learned_reward(action)\n",
        "        - KL_COEFFICIENT * distance_from_reference^2\n",
        "\n",
        "    The reference policy always produces the zero vector.\n",
        "\n",
        "    This is a small, controlled proxy for policy optimization,\n",
        "    not a full PPO or language-model training implementation.\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    action = nn.Parameter(\n",
        "        torch.zeros(1, INPUT_DIM, device=DEVICE)\n",
        "    )\n",
        "\n",
        "    optimizer = torch.optim.Adam(\n",
        "        [action], lr=LEARNING_RATE\n",
        "    )\n",
        "\n",
        "    history = []\n",
        "\n",
        "    for step in range(OPTIMIZATION_STEPS + 1):\n",
        "        with torch.no_grad():\n",
        "            current_action = action.detach().clamp(-4, 4)\n",
        "\n",
        "            proxy = model(current_action).item()\n",
        "            actual = true_reward(current_action).item()\n",
        "\n",
        "            feature_values = current_action.squeeze(0).cpu().numpy()\n",
        "\n",
        "            history.append({\n",
        "                \"step\": step,\n",
        "                \"proxy_reward\": proxy,\n",
        "                \"true_reward\": actual,\n",
        "                \"reward_gap\": proxy - actual,\n",
        "                \"useful_feature_norm\": float(\n",
        "                    np.linalg.norm(feature_values[:3])\n",
        "                ),\n",
        "                \"nuisance_feature_norm\": float(\n",
        "                    np.linalg.norm(feature_values[3:])\n",
        "                ),\n",
        "                **{\n",
        "                    f\"feature_{i}\": float(feature_values[i])\n",
        "                    for i in range(INPUT_DIM)\n",
        "                },\n",
        "            })\n",
        "\n",
        "        if step == OPTIMIZATION_STEPS:\n",
        "            break\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        bounded_action = action.clamp(-4, 4)\n",
        "\n",
        "        predicted_reward = model(bounded_action).mean()\n",
        "        reference_penalty = KL_COEFFICIENT * (\n",
        "            bounded_action ** 2\n",
        "        ).mean()\n",
        "\n",
        "        # Gradient ascent, implemented as minimizing the negative.\n",
        "        loss = -predicted_reward + reference_penalty\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "    return pd.DataFrame(history)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Run experiments across model sizes and data sizes\n",
        "# ============================================================\n",
        "\n",
        "all_histories = []\n",
        "summary_rows = []\n",
        "\n",
        "for hidden_size in MODEL_SIZES:\n",
        "    for data_size in DATA_SIZES:\n",
        "        print(\n",
        "            f\"Training model: hidden_size={hidden_size}, \"\n",
        "            f\"preference_pairs={data_size}\"\n",
        "        )\n",
        "\n",
        "        # Use a reproducible but different initialization/data\n",
        "        # seed for each experimental condition.\n",
        "        experiment_seed = (\n",
        "            SEED + hidden_size * 1000 + data_size\n",
        "        )\n",
        "        random.seed(experiment_seed)\n",
        "        np.random.seed(experiment_seed)\n",
        "        torch.manual_seed(experiment_seed)\n",
        "\n",
        "        model = train_reward_model(hidden_size, data_size)\n",
        "        history = optimize_policy(model)\n",
        "\n",
        "        history[\"model_size\"] = hidden_size\n",
        "        history[\"data_size\"] = data_size\n",
        "        all_histories.append(history)\n",
        "\n",
        "        # The over-optimization peak is the step at which\n",
        "        # the true reward is highest during policy optimization.\n",
        "        peak_index = history[\"true_reward\"].idxmax()\n",
        "        peak = history.loc[peak_index]\n",
        "        final = history.iloc[-1]\n",
        "        initial = history.iloc[0]\n",
        "\n",
        "        # Proxy reward can keep increasing even as true reward\n",
        "        # declines. Measure this separately.\n",
        "        proxy_peak_index = history[\"proxy_reward\"].idxmax()\n",
        "        proxy_peak = history.loc[proxy_peak_index]\n",
        "\n",
        "        summary_rows.append({\n",
        "            \"model_size\": hidden_size,\n",
        "            \"data_size\": data_size,\n",
        "            \"peak_step\": int(peak[\"step\"]),\n",
        "            \"peak_true_reward\": peak[\"true_reward\"],\n",
        "            \"final_true_reward\": final[\"true_reward\"],\n",
        "            \"true_reward_drop_after_peak\": (\n",
        "                peak[\"true_reward\"] - final[\"true_reward\"]\n",
        "            ),\n",
        "            \"initial_true_reward\": initial[\"true_reward\"],\n",
        "            \"final_proxy_reward\": final[\"proxy_reward\"],\n",
        "            \"final_reward_gap\": final[\"reward_gap\"],\n",
        "            \"peak_proxy_step\": int(proxy_peak[\"step\"]),\n",
        "            \"peak_proxy_true_reward\": proxy_peak[\"true_reward\"],\n",
        "            \"peak_nuisance_norm\": peak[\"nuisance_feature_norm\"],\n",
        "            \"final_nuisance_norm\": final[\"nuisance_feature_norm\"],\n",
        "            \"peak_useful_norm\": peak[\"useful_feature_norm\"],\n",
        "        })\n",
        "\n",
        "# Combine and save all experimental data.\n",
        "results = pd.concat(all_histories, ignore_index=True)\n",
        "summary = pd.DataFrame(summary_rows)\n",
        "\n",
        "results.to_csv(\"optimization_trajectories.csv\", index=False)\n",
        "summary.to_csv(\"overoptimization_summary.csv\", index=False)\n",
        "\n",
        "print(\"\\n=== Over-optimization summary ===\")\n",
        "print(summary.round(4).to_string(index=False))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Plot proxy reward versus true reward\n",
        "# ============================================================\n",
        "\n",
        "fig, axes = plt.subplots(\n",
        "    len(MODEL_SIZES),\n",
        "    len(DATA_SIZES),\n",
        "    figsize=(15, 11),\n",
        "    sharex=True,\n",
        ")\n",
        "\n",
        "for row, hidden_size in enumerate(MODEL_SIZES):\n",
        "    for col, data_size in enumerate(DATA_SIZES):\n",
        "        ax = axes[row, col]\n",
        "\n",
        "        subset = results[\n",
        "            (results[\"model_size\"] == hidden_size)\n",
        "            & (results[\"data_size\"] == data_size)\n",
        "        ]\n",
        "\n",
        "        ax.plot(\n",
        "            subset[\"step\"],\n",
        "            subset[\"proxy_reward\"],\n",
        "            label=\"Proxy reward\",\n",
        "        )\n",
        "        ax.plot(\n",
        "            subset[\"step\"],\n",
        "            subset[\"true_reward\"],\n",
        "            label=\"True reward\",\n",
        "        )\n",
        "\n",
        "        peak_idx = subset[\"true_reward\"].idxmax()\n",
        "        peak = results.loc[peak_idx]\n",
        "\n",
        "        ax.axvline(\n",
        "            peak[\"step\"],\n",
        "            linestyle=\"--\",\n",
        "            alpha=0.7,\n",
        "            label=\"True-reward peak\",\n",
        "        )\n",
        "\n",
        "        ax.set_title(\n",
        "            f\"Hidden={hidden_size}, data={data_size}\"\n",
        "        )\n",
        "        ax.set_xlabel(\"Optimization step\")\n",
        "        ax.set_ylabel(\"Reward\")\n",
        "        ax.grid(alpha=0.25)\n",
        "\n",
        "axes[0, 0].legend(fontsize=8)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"reward_trajectories.png\", dpi=180)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Measure where the peak moves\n",
        "# ============================================================\n",
        "\n",
        "pivot = summary.pivot(\n",
        "    index=\"model_size\",\n",
        "    columns=\"data_size\",\n",
        "    values=\"peak_step\",\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.heatmap(\n",
        "    pivot,\n",
        "    annot=True,\n",
        "    fmt=\".0f\",\n",
        "    cmap=\"viridis\",\n",
        ")\n",
        "plt.title(\"True-reward peak location\")\n",
        "plt.xlabel(\"Number of preference pairs\")\n",
        "plt.ylabel(\"Reward model hidden size\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"peak_location_heatmap.png\", dpi=180)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Diagnose policy exploitation\n",
        "# ============================================================\n",
        "\n",
        "diagnosis = summary.copy()\n",
        "\n",
        "diagnosis[\"interpretation\"] = np.select(\n",
        "    [\n",
        "        diagnosis[\"true_reward_drop_after_peak\"] > 0.1,\n",
        "        diagnosis[\"final_reward_gap\"] > 0.5,\n",
        "        diagnosis[\"final_nuisance_norm\"] >\n",
        "            diagnosis[\"peak_nuisance_norm\"] + 0.1,\n",
        "    ],\n",
        "    [\n",
        "        \"True reward deteriorated after its peak\",\n",
        "        \"Large proxy-versus-true reward gap\",\n",
        "        \"Policy moved toward irrelevant features\",\n",
        "    ],\n",
        "    default=\"No strong exploitation signal under current thresholds\",\n",
        ")\n",
        "\n",
        "print(\"\\n=== Exploitation diagnosis ===\")\n",
        "print(\n",
        "    diagnosis[\n",
        "        [\n",
        "            \"model_size\",\n",
        "            \"data_size\",\n",
        "            \"peak_step\",\n",
        "            \"true_reward_drop_after_peak\",\n",
        "            \"final_reward_gap\",\n",
        "            \"peak_nuisance_norm\",\n",
        "            \"final_nuisance_norm\",\n",
        "            \"interpretation\",\n",
        "        ]\n",
        "    ].round(4).to_string(index=False)\n",
        ")\n",
        "\n",
        "# Compare nuisance feature growth across optimization.\n",
        "fig, ax = plt.subplots(figsize=(9, 5))\n",
        "\n",
        "for hidden_size in MODEL_SIZES:\n",
        "    for data_size in DATA_SIZES:\n",
        "        subset = results[\n",
        "            (results[\"model_size\"] == hidden_size)\n",
        "            & (results[\"data_size\"] == data_size)\n",
        "        ]\n",
        "\n",
        "        ax.plot(\n",
        "            subset[\"step\"],\n",
        "            subset[\"nuisance_feature_norm\"],\n",
        "            label=f\"Size={hidden_size}, data={data_size}\",\n",
        "        )\n",
        "\n",
        "ax.set_title(\"Growth of irrelevant features during optimization\")\n",
